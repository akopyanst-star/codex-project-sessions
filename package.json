{
  "name": "codex-project-sessions",
  "displayName": "Codex Project Sessions (unofficial)",
  "description": "Unofficial project-scoped Codex sessions list in the VS Code activity bar. Not affiliated with OpenAI.",
  "version": "0.9.1",
  "publisher": "community-local",
  "engines": {
    "vscode": "^1.103.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "files": [
    "extension.js",
    "resources/sessions.svg",
    "LICENSE",
    "README.md"
  ],
  "extensionDependencies": [
    "openai.chatgpt"
  ],
  "contributes": {
    "commands": [
      {
        "command": "codexProjectSessions.newChat",
        "title": "New Codex Chat in Editor",
        "category": "Codex Project",
        "icon": "$(add)"
      },
      {
        "command": "codexProjectSessions.refresh",
        "title": "Refresh Project Sessions",
        "category": "Codex Project",
        "icon": "$(refresh)"
      },
      {
        "command": "codexProjectSessions.openChat",
        "title": "Open Codex Chat in Editor",
        "category": "Codex Project"
      },
      {
        "command": "codexProjectSessions.removeChat",
        "title": "Remove from Project List",
        "category": "Codex Project",
        "icon": "$(trash)"
      },
      {
        "command": "codexProjectSessions.restoreChats",
        "title": "Restore Removed Chats",
        "category": "Codex Project"
      },
      {
        "command": "codexProjectSessions.search",
        "title": "Search Sessions",
        "category": "Codex Project",
        "icon": "$(search)"
      },
      {
        "command": "codexProjectSessions.toggleActive",
        "title": "Toggle Active Sessions",
        "category": "Codex Project",
        "icon": "$(filter)"
      },
      {
        "command": "codexProjectSessions.newGroup",
        "title": "New Group",
        "category": "Codex Project",
        "icon": "$(add)"
      },
      {
        "command": "codexProjectSessions.moveToGroup",
        "title": "Move to Group",
        "category": "Codex Project"
      },
      {
        "command": "codexProjectSessions.deleteGroup",
        "title": "Delete Group",
        "category": "Codex Project"
      },
      {
        "command": "codexProjectSessions.openAccount",
        "title": "View Account Details",
        "category": "Codex Project"
      },
      {
        "command": "codexProjectSessions.restoreOfficialExtension",
        "title": "Restore official Codex extension files",
        "category": "Codex Project"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codexProjectSessions",
          "title": "Codex Sessions (unofficial)",
          "icon": "resources/sessions.svg"
        }
      ]
    },
    "views": {
      "codexProjectSessions": [
        {
          "id": "codexProjectSessions.usage",
          "name": "Account & Usage"
        },
        {
          "id": "codexProjectSessions.sessions",
          "name": "Session Manager"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "codexProjectSessions.newChat",
          "when": "view == codexProjectSessions.sessions",
          "group": "navigation@1"
        },
        {
          "command": "codexProjectSessions.refresh",
          "when": "view == codexProjectSessions.sessions || view == codexProjectSessions.usage",
          "group": "navigation@2"
        },
        {
          "command": "codexProjectSessions.toggleActive",
          "when": "view == codexProjectSessions.sessions",
          "group": "navigation@3"
        },
        {
          "command": "codexProjectSessions.search",
          "when": "view == codexProjectSessions.sessions",
          "group": "navigation@4"
        },
        {
          "command": "codexProjectSessions.newGroup",
          "when": "view == codexProjectSessions.sessions",
          "group": "navigation@5"
        },
        {
          "command": "codexProjectSessions.restoreChats",
          "when": "view == codexProjectSessions.sessions",
          "group": "navigation@6"
        }
      ],
      "view/item/context": [
        {
          "command": "codexProjectSessions.removeChat",
          "when": "view == codexProjectSessions.sessions && viewItem == codexProjectSession",
          "group": "inline@1"
        },
        {
          "command": "codexProjectSessions.removeChat",
          "when": "view == codexProjectSessions.sessions && viewItem == codexProjectSession",
          "group": "navigation@1"
        },
        {
          "command": "codexProjectSessions.moveToGroup",
          "when": "view == codexProjectSessions.sessions && viewItem == codexProjectSession",
          "group": "navigation@2"
        },
        {
          "command": "codexProjectSessions.deleteGroup",
          "when": "view == codexProjectSessions.sessions && viewItem == codexProjectGroupDeletable",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "title": "Codex Project Sessions",
      "properties": {
        "codexProjectSessions.liveUsage": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "markdownDescription": "Show live Codex limits by asking the local `codex app-server` of the official extension (experimental OpenAI protocol, refreshed every 5 minutes while the panel is visible). Turn off to use only local session records."
        },
        "codexProjectSessions.patchOfficialExtension": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "markdownDescription": "Edits files of the official OpenAI Codex extension so the + button opens a new chat in an editor tab and first-run screens do not repeat. Backups are kept; use the command `Restore official Codex extension files` to roll back. Use at your own risk."
        }
      }
    }
  },
  "scripts": {
    "test": "node test.js"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/akopyanst-star/codex-project-sessions"
  }
}
